<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Transcriber.SettingsWindow"
        Title="Настройки Transcriber" Width="460" Height="440" MinWidth="420" MinHeight="390"
        WindowStartupLocation="CenterOwner" CanResize="True">
  <ScrollViewer>
    <StackPanel Margin="28" Spacing="14">
      <TextBlock Text="Настройки" FontSize="28" FontWeight="Bold" />
      <TextBlock Text="Внешний вид и производительность" Opacity="0.68" />
      <TextBlock Text="Тема приложения" FontWeight="SemiBold" Margin="0,10,0,0" />
      <ComboBox Name="ThemeBox" />
      <TextBlock Text="Устройство распознавания" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ComboBox Name="DeviceBox" />
      <TextBlock Name="HintLabel" TextWrapping="Wrap" Opacity="0.68" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
        <Button Classes="subtle" Content="Отмена" Click="Cancel_Click" />
        <Button Classes="primary" Content="Сохранить" Click="Save_Click" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
